<div>
<label class="flex min-w-0 items-center gap-2 text-sm text-gray-700 lg:gap-0">
  <span class="w-full lg:max-w-[100px] lg:me-2 block leading-[1.2] overflow-hidden">{{ field.label }}{% if field.required %} *{% endif %}</span>
  <input id="{{ field.id }}" class="h-4 w-4 shrink-0 rounded border-gray-300" type="checkbox"
         name="{{ field.inputName }}"
         value="{{ field.defaultValue | default: 'yes' }}"
         {% if field.checked %}checked{% endif %}
         {% if field.required %}required{% endif %}>
</label>
</div>
