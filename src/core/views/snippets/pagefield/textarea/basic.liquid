<div>
<label for="{{ field.id }}" class="min-w-0 block lg:flex items-start">
  <span class="mt-3 w-full lg:max-w-[100px] lg:me-2 block text-sm font-medium text-gray-700 leading-[1.2] mb-1 lg:mb-0 overflow-hidden">{% if field.labelKey != blank %}{{ field.labelKey | t }}{% else %}{{ field.label }}{% endif %}{% if field.required %} *{% endif %}</span>
  <textarea id="{{ field.id }}" name="{{ field.inputName }}" rows="4"
            placeholder="{% if field.placeholderKey != blank %}{{ field.placeholderKey | t }}{% else %}{{ field.placeholder }}{% endif %}"
            class="block min-w-0 w-full max-w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-y"
            {% if field.required %}required{% endif %}>{{ field.value }}</textarea>
</label>
</div>
