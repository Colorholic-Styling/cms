<div>
<fieldset class="min-w-0 block lg:grid lg:grid-cols-[100px_minmax(0,1fr)] lg:gap-2">
  <legend class="w-full lg:max-w-[100px] lg:me-2 block text-sm font-medium text-gray-700 leading-[1.2] mb-1 lg:mb-0 overflow-hidden">{{ field.label }}{% if field.required %} *{% endif %}</legend>
  <div class="flex flex-wrap gap-3">
    {% for option in field.options %}
      <label class="inline-flex items-center gap-2 text-sm leading-[1.2] text-gray-700">
        <input type="radio" name="{{ field.inputName }}" value="{{ option.value }}"{% if option.selected %} checked{% endif %}{% if field.required %} required{% endif %}>
        <span>{{ option.label }}</span>
      </label>
    {% endfor %}
  </div>
</fieldset>
</div>
