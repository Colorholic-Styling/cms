<div>
<label for="{{ field.id }}" class="min-w-0 block lg:flex items-center">
  <span class="w-full lg:max-w-[100px] lg:me-2 block text-sm font-medium text-gray-700 leading-[1.2] mb-1 lg:mb-0 overflow-hidden">{{ field.label }}{% if field.required %} *{% endif %}</span>
  <input id="{{ field.id }}" type="datetime-local" name="{{ field.inputName }}"
         value="{{ field.value }}"
         max="2200-12-30"
         class="block min-w-0 w-full max-w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
         {% if field.required %}required{% endif %}>
</label>
</div>
