<div class="min-w-0 max-w-xl px-4 pb-1 sm:px-6 lg:px-8">
  {% if readOnly %}
    <div class="mb-4 px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 text-sm text-gray-600">{{ "view_strings.sections_taxonomy_form.you_don_t_have_permission_to_edit_taxonomies" | t }}</div>
  {% endif %}
  <form id="taxonomy-form" method="POST" action="{{ action }}" class="min-w-0 space-y-4">
    <label for="taxonomy_name" class="block min-w-0">
      <span class="block text-sm font-medium text-gray-700 mb-1">{{ "view_strings.sections_taxonomy_form.name" | t }}</span>
      <input id="taxonomy_name" name="name" required value="{{ name }}"{% if readOnly %} readonly{% endif %} class="block min-w-0 w-full max-w-full px-3 py-2 border border-gray-300 rounded-lg text-sm{% if readOnly %} bg-gray-50 text-gray-600{% endif %}">
    </label>
    <label for="taxonomy_slug" class="block min-w-0">
      <span class="block text-sm font-medium text-gray-700 mb-1">{{ "view_strings.sections_taxonomy_form.slug" | t }}</span>
      <input id="taxonomy_slug" name="slug" value="{{ slug }}"{% if readOnly %} readonly{% endif %} class="block min-w-0 w-full max-w-full px-3 py-2 border border-gray-300 rounded-lg text-sm{% if readOnly %} bg-gray-50 text-gray-600{% endif %}">
    </label>
  </form>
</div>
