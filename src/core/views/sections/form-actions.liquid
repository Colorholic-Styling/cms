{% assign actionsWidth = 'max-w-full' %}
{% if section.settings.width == '4xl' %}{% assign actionsWidth = 'max-w-4xl' %}{% elsif section.settings.width == '3xl' %}{% assign actionsWidth = 'max-w-3xl' %}{% elsif section.settings.width == '2xl' %}{% assign actionsWidth = 'max-w-2xl' %}{% elsif section.settings.width == 'xl' %}{% assign actionsWidth = 'max-w-xl' %}{% endif %}
<div class="min-w-0 {{ actionsWidth }} px-4 pb-5 pt-4 sm:px-6 sm:pb-8 lg:px-8">
  {% if section.settings.deleteAction and section.settings.deleteAction != '' %}
    <form id="{{ section.settings.deleteFormId }}"
          method="POST"
          action="{{ section.settings.deleteAction }}"
          data-confirm="{{ section.settings.deleteConfirm }}"></form>
  {% endif %}
  <div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
    {% if section.settings.showSave == 'yes' %}
      <button form="{{ section.settings.formId }}"
              type="submit"
              class="w-full rounded-lg bg-indigo-600 px-6 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-700 sm:w-auto">{{ section.settings.saveLabel }}</button>
    {% endif %}
    <a href="{{ section.settings.cancelHref }}"
       class="w-full rounded-lg border border-gray-300 bg-white px-6 py-2 text-center text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 sm:w-auto">{{ section.settings.cancelLabel }}</a>
    {% if section.settings.deleteAction and section.settings.deleteAction != '' %}
      <button form="{{ section.settings.deleteFormId }}"
              type="submit"
              class="w-full rounded-lg bg-red-600 px-6 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-red-700 sm:ml-auto sm:w-auto">{{ section.settings.deleteLabel }}</button>
    {% endif %}
  </div>
</div>
