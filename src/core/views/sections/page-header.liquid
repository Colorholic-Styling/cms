{% assign headerWidth = 'max-w-full' %}
{% if section.settings.width == '4xl' %}{% assign headerWidth = 'max-w-4xl' %}{% elsif section.settings.width == '3xl' %}{% assign headerWidth = 'max-w-3xl' %}{% elsif section.settings.width == '2xl' %}{% assign headerWidth = 'max-w-2xl' %}{% elsif section.settings.width == 'xl' %}{% assign headerWidth = 'max-w-xl' %}{% endif %}
<div class="min-w-0 {{ headerWidth }} px-4 my-4 sm:px-6 sm:mt-8 lg:px-8">
  <div class="flex min-w-0 items-start justify-between gap-4">
    <div class="flex min-w-0 items-start gap-3">
      {% if section.settings.backHref and section.settings.backHref != '' %}
        <a href="{{ section.settings.backHref }}"
           title="{{ section.settings.backLabel }}"
           aria-label="{{ section.settings.backLabel }}"
           class="mt-1 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 hover:text-gray-900">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#arrow-left"></use></svg>
        </a>
      {% endif %}
      <div class="min-w-0">
        <h2 class="break-words text-2xl font-bold text-gray-900">{{ section.settings.title }}</h2>
        {% if section.settings.description and section.settings.description != '' %}
          <p class="mt-1 text-sm text-gray-500">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    </div>
    {% if section.blocks %}
      <div class="flex shrink-0 flex-row gap-2 sm:items-center">
        {% for action in section.blocks %}
          {% if action.settings.show != 'no' %}
            {% if action.settings.variant == 'primary' %}
              <a href="{{ action.settings.href }}"
                 title="{{ action.settings.label }}"
                 aria-label="{{ action.settings.label }}"
                 class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700">
                {% if action.settings.icon and action.settings.icon != '' %}<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#{{ action.settings.icon }}"></use></svg>{% endif %}
                <span class="hidden lg:inline">{{ action.settings.label }}</span>
              </a>
            {% else %}
              <a href="{{ action.settings.href }}"
                 title="{{ action.settings.label }}"
                 aria-label="{{ action.settings.label }}"
                 class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-4 text-sm font-semibold text-gray-700 hover:bg-gray-50">
                {% if action.settings.icon and action.settings.icon != '' %}<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#{{ action.settings.icon }}"></use></svg>{% endif %}
                <span class="hidden lg:inline">{{ action.settings.label }}</span>
              </a>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
