{
  "sections": {
    "header": {
      "type": "page-header",
      "settings": {
        "title": "{{ pageTitle }}",
        "description": "{{ pageCountLabel }}"
      },
      "blocks": {
        "new": {
          "type": "link",
          "settings": {
            "href": "/admin/pages/new",
            "label": "{{ 'view_strings.sections_dashboard.new_page' | t }}",
            "icon": "plus",
            "variant": "primary"
          }
        }
      },
      "block_order": [
        "new"
      ]
    },
    "content": {
      "type": "dashboard"
    }
  },
  "order": [
    "header",
    "content"
  ]
}
